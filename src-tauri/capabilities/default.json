{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window (spec 15.3)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "os:default",
    "log:default",
    "window-state:default",
    "updater:default",
    "process:allow-restart",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "os:allow-hostname",
    "opener:allow-reveal-item-in-dir",
    "fs:allow-read-text-file",
    "fs:allow-read-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Shalav" },
        { "path": "$DOCUMENT/Shalav/**" },
        { "path": "$APPCONFIG" },
        { "path": "$APPCONFIG/**" },
        { "path": "$APPCACHE" },
        { "path": "$APPCACHE/**" },
        { "path": "$APPLOG" },
        { "path": "$APPLOG/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://raw.githubusercontent.com/michael-maltsev/technion-sap-info-fetcher/*" },
        { "url": "https://sap.cheesefork.cf/*" },
        { "url": "https://oauth2.googleapis.com/*" },
        { "url": "https://www.googleapis.com/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://console.anthropic.com/*" },
        { "url": "https://accounts.google.com/*" },
        { "url": "https://github.com/<owner>/<repo>*" }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$DOCUMENT/Shalav/**" },
        { "path": "$APPLOG" }
      ]
    }
  ]
}
