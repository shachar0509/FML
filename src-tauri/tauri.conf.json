{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shalav",
  "version": "../package.json",
  "identifier": "il.shalav.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Shalav",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Hebrew", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "fs": { "requireLiteralLeadingDot": false },
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_OUTPUT_OF__pnpm_tauri_signer_generate",
      "endpoints": ["https://github.com/<owner>/<repo>/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
